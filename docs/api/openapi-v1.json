      "Body_optimize_v1_optimize_post": {
        "properties": {
          "execution_mode": {
            "default": "auto",
            "description": "Execution topology: 'auto' picks dense under the dense memory policy (OPENLITHOHUB_MAX_DENSE_BYTES) and streaming for supported large jobs; unsupported large jobs fail closed (400) instead of silently materializing a full-chip raster.",
            "title": "Execution Mode",
            "type": "string"
          },
          "layer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "OASIS/GDSII layer 'LAYER:DTYPE'; required for multi-layer files.",
            "title": "Layer"
          },
          "layout": {
            "contentMediaType": "application/octet-stream",
            "description": "Layout file (.oas, .gds, .pt, .npy)",
            "title": "Layout",
            "type": "string"
          },
          "min_area_nm2": {
            "default": 0.0,
            "description": "Drop curvilinear shapes below this polygon area (nm^2) at export. Default 0.0 keeps every shape (Hackathon-safe); set >0 for fab-oriented export quality. This export does NOT establish foundry sign-off or complete manufacturing-rule compliance.",
            "title": "Min Area Nm2",
            "type": "number"
          },
          "model": {
            "description": "Registered model name.",
            "title": "Model",
            "type": "string"
          },
          "node": {
            "default": "3nm-euv",
            "description": "Process node.",
            "title": "Node",
            "type": "string"
          },
          "pixel_nm": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pixel size in nanometers. If unset, falls back to the node's native pitch (1.0 nm/px is treated as a real value, not a sentinel).",
            "title": "Pixel Nm"
          },
          "pretrained": {
            "default": false,
            "description": "Load pretrained weights when supported.",
            "title": "Pretrained",
            "type": "boolean"
          },
          "tile_size": {
            "default": 2048,
            "description": "Tile size in pixels.",
            "title": "Tile Size",
            "type": "integer"
          },
          "writer": {
            "default": "mbmw",
            "description": "Target writer: mbmw or vsb.",
            "title": "Writer",
            "type": "string"
          }
        },
        "required": [
          "layout",
          "model"
        ],
        "title": "Body_optimize_v1_optimize_post",
        "type": "object"
      },
